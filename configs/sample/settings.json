{
  "schema": 3,
  "業務設定": {
    "入力ファイル": {
      "取引": { "ファイル名": "01_取引データ.csv", "一致": "前方一致", "キー列": "【共通】取引ID" },
      "決済": { "ファイル名": "02_決済データ.csv", "一致": "前方一致", "キー列": "オーダーID" },
      "受付": { "ファイル名": "03_受付データ.csv", "一致": "前方一致", "キー列": "受付時＿識別番号" },
      "削除用": { "ファイル名": "04_削除用_手続完了.csv", "一致": "前方一致", "キー列": ["識別番号", "受付番号"] }
    },
    "計算列": [
      { "列名": "識別番号", "式": "regexExtract(取引.【共通】取引ID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')" },
      { "列名": "識別番号", "式": "regexExtract(決済.オーダーID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')" },
      { "列名": "受付番号（照合用）", "式": "regexExtract(決済.備考2, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')" },
      { "列名": "利用者ID", "式": "splitPart(決済.氏名, '-', 0)" },
      { "列名": "利用者氏名", "式": "splitPart(決済.氏名, '-', 1)" },
      { "列名": "利用者区分", "式": "splitPart(決済.備考2, '/', 5)" },
      { "列名": "生年月日", "式": "splitPart(決済.備考2, '/', 1)" },
      { "列名": "受付拠点", "式": "splitPart(決済.備考2, '/', 4)" },
      { "列名": "申込者氏名", "式": "splitPart(決済.備考2, '/', 6)" },
      { "列名": "識別番号", "式": "regexExtract(受付.受付時＿識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')" },
      { "列名": "受付番号（照合用）", "式": "regexExtract(受付.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')" },
      { "列名": "識別番号（照合用）", "式": "regexExtract(削除用.識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')" },
      { "列名": "受付番号（照合用）", "式": "regexExtract(削除用.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')" }
    ],
    "結合": [
      { "左": "決済.識別番号", "右": "取引.識別番号", "残す行": "一致する行のみ" },
      { "左": "決済.識別番号", "右": "受付.識別番号", "残す行": "左の全行" }
    ],
    "支払済の判定条件": [
      { "列": "取引.【共通】ステータス", "値": "支払済" },
      { "列": "決済.決済ステータス", "値": "決済済" }
    ],
    "台帳のキー列": ["決済.識別番号", "決済.受付番号（照合用）"],
    "検索対象の列": ["決済.識別番号", "決済.受付番号（照合用）", "受付.受付番号（照合用）"],
    "台帳の追加列": ["取引.【共通】取引ID", "決済.オーダーID", "決済.決済金額", "取引.【共通】ステータス", "取引.【共通】取引結果"],
    "削除の照合条件": {
      "ファイル": "削除用",
      "一致させる列": [
        { "台帳の列": "決済.識別番号", "削除用の列": "削除用.識別番号（照合用）" },
        { "台帳の列": ["受付.受付番号（照合用）", "決済.受付番号（照合用）"], "削除用の列": "削除用.受付番号（照合用）" }
      ]
    },
    "画面": {
      "検索欄のラベル": "識別番号／受付番号",
      "左上の枠": {
        "見出し": "利用者情報",
        "行": [
          { "ラベル": "利用者ID", "列": "決済.利用者ID" },
          { "ラベル": "利用者氏名", "列": "決済.利用者氏名" },
          { "ラベル": "利用者区分", "列": "決済.利用者区分" }
        ]
      },
      "右上の枠": {
        "見出し": "受付情報",
        "行": [
          { "ラベル": "申請年月日", "列": "受付.申請年月日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" },
          { "ラベル": "受付番号", "列": "決済.受付番号（照合用）" },
          { "ラベル": "識別番号", "列": "決済.識別番号" },
          { "ラベル": "申込者氏名", "列": "決済.申込者氏名" },
          { "ラベル": "生年月日", "列": "決済.生年月日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" },
          { "ラベル": "契約区分（期間）", "列": "受付.変更後の契約区分期間" },
          { "ラベル": "受付拠点", "列": "決済.受付拠点" }
        ]
      },
      "文章枠1": { "見出し": "意見欄", "列": "受付.意見欄" },
      "文章枠2": { "見出し": "変更後の計画", "列": "受付.変更後の計画" },
      "文章枠3": { "見出し": "利用状態", "列": "受付.利用状態" },
      "決済状況の帯": { "見出し": "決済状況", "支払済の表示": "支払済", "未決済の表示": "未決済" },
      "候補一覧": [
        { "見出し": "受付番号", "列": "決済.受付番号（照合用）" },
        { "見出し": "識別番号", "列": "決済.識別番号" },
        { "見出し": "申込者氏名", "列": "決済.申込者氏名" },
        { "見出し": "申請年月日", "列": "受付.申請年月日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" }
      ],
      "帳票出力の初期項目": [
        "受付.受付時＿識別番号", "決済.受付番号", "受付.受付番号", "受付.申請年月日", "決済.申込者氏名",
        "決済.生年月日", "決済.決済ステータス", "確認状態", "決済.利用者ID", "決済.利用者氏名", "決済.利用者区分"
      ]
    }
  },
  "保存先": {
    "データ": "data",
    "統合台帳": "data/統合台帳.xlsx",
    "操作ログ": "data/操作ログ.log"
  },
  "検索": {
    "候補一覧の表示件数": 100
  },
  "監視対象": {
    "対象": [
      {
        "enabled": true,
        "name": "メモ帳",
        "window": {
          "className": "Notepad",
          "processName": "Notepad",
          "scope": "children"
        },
        "path": [],
        "field": {
          "className": "RichEditD2DPT",
          "controlTypes": [
            "Document"
          ],
          "requireValuePattern": true,
          "scope": "descendants"
        },
        "read": "value"
      }
    ]
  }
}
