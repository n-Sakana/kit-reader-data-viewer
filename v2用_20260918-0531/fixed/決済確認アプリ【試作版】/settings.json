{
  "schema": 3,
  "paths": {
    "dataDir": "data",
    "ledger": "data/統合台帳.xlsx",
    "log": "data/操作ログ.log"
  },
  "search": {
    "pattern": "^(?:[A-Z]{2}[0-9]{8}[A-Z]{2}|(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10})$",
    "candidateRowsShown": 100
  },
  "watch": {
    "pollMs": 40,
    "stableMs": 120,
    "rebindMs": 400,
    "preferFocusedWindow": true,
    "targets": [
      {
        "enabled": true,
        "name": "メモ帳",
        "window": {
          "className": "Notepad",
          "processName": "Notepad",
          "scope": "children"
        },
        "path": [],
        "field": {
          "className": "RichEditD2DPT",
          "controlTypes": [
            "Document"
          ],
          "requireValuePattern": true,
          "scope": "descendants"
        },
        "read": "value"
      }
    ]
  },
  "data": {
    "encoding": "utf-8",
    "tables": {
      "TXN": {
        "label": "①取引データ",
        "file": "01_取引データ.csv",
        "fileMatch": "exact",
        "key": "【共通】取引ID",
        "keyValidation": {
          "characters": "unicode",
          "length": "variable",
          "duplicates": "error",
          "empty": "error"
        }
      },
      "PAY": {
        "label": "②決済データ",
        "file": "02_決済データ.csv",
        "fileMatch": "exact",
        "key": "オーダーID",
        "keyValidation": {
          "characters": "unicode",
          "length": "variable",
          "duplicates": "error",
          "empty": "error"
        }
      },
      "APP": {
        "label": "③受付データ",
        "file": "03_受付データ.csv",
        "fileMatch": "exact",
        "key": "受付時＿識別番号",
        "keyValidation": {
          "characters": "unicode",
          "length": "variable",
          "duplicates": "error",
          "empty": "error"
        }
      },
      "DEL": {
        "label": "削除用・手続完了データ",
        "file": "04_削除用_手続完了.csv",
        "fileMatch": "exact",
        "key": [
          "識別番号",
          "受付番号"
        ],
        "keyValidation": {
          "characters": "unicode",
          "length": "variable",
          "duplicates": "error",
          "empty": "error"
        }
      }
    },
    "types": {
      "TXN.【共通】金額": {
        "type": "number"
      },
      "PAY.決済金額": {
        "type": "number"
      },
      "APP.申込日": {
        "type": "date",
        "format": "yyyyMMdd"
      }
    },
    "labels": {
      "TXN.【共通】取引ID": "取引検索システム取引ID",
      "TXN.【共通】ステータス": "取引検索システム決済状態",
      "TXN.【共通】取引結果": "取引検索システム取引結果",
      "TXN.【共通】金額": "取引検索システム金額",
      "TXN.識別番号照合用": "取引検索システム識別番号",
      "PAY.オーダーID": "オーダーID",
      "PAY.決済ステータス": "決済ステータス",
      "PAY.決済金額": "決済金額",
      "PAY.備考2": "備考2",
      "PAY.受付番号": "受付番号",
      "PAY.識別番号照合用": "決済識別番号",
      "PAY.受付番号照合用": "決済受付番号",
      "APP.受付番号": "受付番号",
      "APP.受付時＿識別番号": "識別番号",
      "APP.識別番号照合用": "受付識別番号",
      "APP.受付番号照合用": "受付データの受付番号",
      "APP.変更後の契約区分期間": "契約区分（期間）",
      "PAY.受付拠点": "受付拠点",
      "APP.意見欄": "意見欄",
      "APP.変更後の計画": "変更後の計画",
      "APP.申込者氏名": "申込人氏名",
      "PAIRED": "取引・決済照合結果",
      "INTEGRATED": "受付情報統合結果",
      "ledger": "IDカード情報照会台帳",
      "APP.申込日": "申込日",
      "PAY.生年月日": "生年月日",
      "PAY.利用者ID": "利用者ID",
      "PAY.利用者氏名": "利用者氏名",
      "PAY.利用者区分": "利用者区分",
      "PAY.氏名": "氏名",
      "target": "削除対象",
      "DEL.識別番号": "削除対象の識別番号",
      "DEL.受付番号": "削除対象の受付番号",
      "DEL.識別番号照合用": "削除対象の識別番号（照合用）",
      "DEL.受付番号照合用": "削除対象の受付番号（照合用）",
      "PAIRED.決済確認済": "決済確認済",
      "mapPaid": "①決済完了の取引",
      "payPaid": "②決済済の取引",
      "bothPaid": "①②とも決済済の取引",
      "matchedApp": "受付データ側の受付番号で一致する案件",
      "matchedPay": "決済データ側の受付番号で一致する案件",
      "targetMatched": "削除用台帳に一致する案件",
      "targetProcessed": "台帳の確認済案件",
      "$work": "台帳確認状態（アプリ付与）"
    },
    "jobs": [
      {
        "id": "delete-processed-records",
        "name": "手続完了かつ共有で確認済の案件を削除",
        "kind": "delete",
        "inputs": [
          {
            "table": "DEL"
          }
        ],
        "steps": [
          {
            "operation": "calculate",
            "target1": "DEL",
            "column": "識別番号照合用",
            "expression": "regexExtract(DEL.識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
            "output": "DEL"
          },
          {
            "operation": "calculate",
            "target1": "DEL",
            "column": "受付番号照合用",
            "expression": "regexExtract(DEL.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')",
            "output": "DEL"
          },
          {
            "operation": "extract",
            "target1": "ledger",
            "target2": "DEL",
            "keys": [
              [
                "PAY.識別番号照合用",
                "APP.受付番号照合用"
              ],
              [
                "DEL.識別番号照合用",
                "DEL.受付番号照合用"
              ]
            ],
            "condition": "match",
            "output": "matchedApp"
          },
          {
            "operation": "extract",
            "target1": "ledger",
            "target2": "DEL",
            "keys": [
              [
                "PAY.識別番号照合用",
                "PAY.受付番号照合用"
              ],
              [
                "DEL.識別番号照合用",
                "DEL.受付番号照合用"
              ]
            ],
            "condition": "match",
            "output": "matchedPay"
          },
          {
            "operation": "extract",
            "target1": "matchedApp",
            "target2": "matchedPay",
            "condition": "either",
            "output": "targetMatched"
          },
          {
            "operation": "extract",
            "target1": "ledger",
            "where": {
              "column": "$work",
              "operator": "equals",
              "value": "TRUE"
            },
            "output": "targetProcessed"
          },
          {
            "operation": "extract",
            "target1": "targetMatched",
            "target2": "targetProcessed",
            "condition": "both",
            "output": "target"
          },
          {
            "operation": "delete",
            "target1": "ledger",
            "target2": "target",
            "output": "ledger"
          }
        ]
      },
      {
        "id": "update-ledger",
        "name": "決済・受付情報を統合して台帳を更新",
        "kind": "update",
        "inputs": [
          {
            "table": "TXN"
          },
          {
            "table": "PAY"
          },
          {
            "table": "APP"
          }
        ],
        "steps": [
          {
            "operation": "calculate",
            "target1": "TXN",
            "column": "識別番号照合用",
            "expression": "regexExtract(TXN.【共通】取引ID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
            "output": "TXN"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "識別番号照合用",
            "expression": "regexExtract(PAY.オーダーID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "受付番号照合用",
            "expression": "regexExtract(PAY.備考2, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "利用者ID",
            "expression": "splitPart(PAY.氏名, '-', 0)",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "利用者氏名",
            "expression": "splitPart(PAY.氏名, '-', 1)",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "利用者区分",
            "expression": "splitPart(PAY.備考2, '/', 5)",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "生年月日",
            "expression": "splitPart(PAY.備考2, '/', 1)",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "PAY",
            "column": "受付拠点",
            "expression": "splitPart(PAY.備考2, '/', 4)",
            "output": "PAY"
          },
          {
            "operation": "calculate",
            "target1": "APP",
            "column": "識別番号照合用",
            "expression": "regexExtract(APP.受付時＿識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
            "output": "APP"
          },
          {
            "operation": "calculate",
            "target1": "APP",
            "column": "受付番号照合用",
            "expression": "regexExtract(APP.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')",
            "output": "APP"
          },
          {
            "operation": "join",
            "target1": "PAY",
            "target2": "TXN",
            "keys": [
              "PAY.識別番号照合用",
              "TXN.識別番号照合用"
            ],
            "condition": "match",
            "output": "PAIRED"
          },
          {
            "operation": "calculate",
            "target1": "PAIRED",
            "column": "決済確認済",
            "expression": "''",
            "output": "PAIRED"
          },
          {
            "operation": "extract",
            "target1": "PAIRED",
            "where": {
              "column": "TXN.【共通】ステータス",
              "operator": "equals",
              "value": "支払済"
            },
            "output": "mapPaid"
          },
          {
            "operation": "extract",
            "target1": "PAIRED",
            "where": {
              "column": "PAY.決済ステータス",
              "operator": "equals",
              "value": "決済済"
            },
            "output": "payPaid"
          },
          {
            "operation": "extract",
            "target1": "mapPaid",
            "target2": "payPaid",
            "condition": "both",
            "output": "bothPaid"
          },
          {
            "operation": "update",
            "target1": "PAIRED",
            "target2": "bothPaid",
            "set": [
              {
                "column": "PAIRED.決済確認済",
                "expression": "'支払済'"
              }
            ],
            "output": "PAIRED"
          },
          {
            "operation": "join",
            "target1": "PAIRED",
            "target2": "APP",
            "keys": [
              "PAY.識別番号照合用",
              "APP.識別番号照合用"
            ],
            "condition": "left",
            "output": "INTEGRATED"
          },
          {
            "operation": "merge",
            "target1": "INTEGRATED",
            "target2": "ledger",
            "keys": [
              [
                "PAY.識別番号照合用",
                "PAY.受付番号照合用"
              ],
              [
                "PAY.識別番号照合用",
                "PAY.受付番号照合用"
              ]
            ],
            "sourceOnly": "add",
            "both": "update",
            "targetOnly": "keep",
            "output": "ledger"
          }
        ]
      }
    ],
    "ledger": {
      "identity": [
        "PAY.識別番号照合用",
        "PAY.受付番号照合用"
      ],
      "search": {
        "columns": [
          "PAY.識別番号照合用",
          "PAY.受付番号照合用",
          "APP.受付番号照合用"
        ],
        "match": "exact"
      },
      "columns": {
        "source": [
          "TXN.【共通】取引ID",
          "PAY.オーダーID",
          "PAY.利用者ID",
          "PAY.利用者氏名",
          "PAY.利用者区分",
          "PAY.識別番号照合用",
          "PAY.受付番号",
          "PAY.受付番号照合用",
          "PAY.決済ステータス",
          "PAY.決済金額",
          "TXN.【共通】ステータス",
          "TXN.【共通】取引結果",
          "APP.受付番号",
          "APP.受付番号照合用",
          "APP.受付時＿識別番号",
          "APP.申込日",
          "APP.申込者氏名",
          "PAY.生年月日",
          "APP.変更後の契約区分期間",
          "PAY.受付拠点",
          "APP.意見欄",
          "APP.変更後の計画",
          "PAIRED.決済確認済"
        ],
        "application": [
          {
            "name": "workState",
            "onSourceChange": "reset"
          }
        ]
      },
      "protectStates": [
        "TRUE"
      ]
    }
  },
  "screen": {
    "bindings": {
      "userId": {
        "field": "PAY.利用者ID",
        "empty": ""
      },
      "userName": {
        "field": "PAY.利用者氏名",
        "empty": ""
      },
      "userCategory": {
        "field": "PAY.利用者区分",
        "empty": ""
      },
      "applicationDate": {
        "field": "APP.申込日",
        "empty": "",
        "format": {
          "kind": "date",
          "from": "yyyyMMdd",
          "to": "yyyy/MM/dd"
        }
      },
      "applicationNumber": {
        "field": "PAY.受付番号照合用",
        "empty": ""
      },
      "cardNumber": {
        "field": "PAY.識別番号照合用",
        "empty": ""
      },
      "applicantName": {
        "field": "APP.申込者氏名",
        "empty": ""
      },
      "birthDate": {
        "field": "PAY.生年月日",
        "empty": "",
        "format": {
          "kind": "date",
          "from": "yyyyMMdd",
          "to": "yyyy/MM/dd"
        }
      },
      "qualification": {
        "field": "APP.変更後の契約区分期間",
        "empty": ""
      },
      "office": {
        "field": "PAY.受付拠点",
        "empty": ""
      },
      "remarks": {
        "field": "APP.意見欄",
        "empty": ""
      },
      "plan": {
        "field": "APP.変更後の計画",
        "empty": ""
      }
    },
    "judgments": {
      "paymentStatus": {
        "source": {
          "field": "PAIRED.決済確認済",
          "requires": [
            "TXN.【共通】取引ID",
            "PAY.オーダーID"
          ]
        },
        "rules": [
          {
            "equals": [
              "支払済"
            ],
            "result": "paid"
          },
          {
            "empty": true,
            "result": "unpaid"
          }
        ],
        "results": {
          "paid": {
            "text": "支払済",
            "look": "ok"
          },
          "undefined": {
            "text": "要確認",
            "look": "undefined"
          },
          "error": {
            "text": "判定エラー",
            "look": "error"
          },
          "unpaid": {
            "text": "未決済",
            "look": "ng"
          }
        }
      }
    },
    "workState": {
      "trigger": "automatic",
      "store": {
        "column": "確認状態"
      },
      "states": [
        {
          "id": "todo",
          "text": "未確認",
          "short": "未確認",
          "look": "neutral",
          "stored": "FALSE"
        },
        {
          "id": "done",
          "text": "確認済",
          "short": "確認済",
          "look": "accent",
          "stored": "TRUE"
        }
      ],
      "initial": "todo",
      "transitions": [
        {
          "from": "todo",
          "to": "done",
          "done": "確認済にしました"
        },
        {
          "from": "done",
          "to": "todo",
          "confirm": "表示中の案件を未確認に戻します。よろしいですか。",
          "done": "未確認に戻しました"
        }
      ],
      "automaticWhen": {
        "judgment": "paymentStatus",
        "result": "paid"
      }
    },
    "export": {
      "defaultFields": [
        "APP.受付時＿識別番号",
        "PAY.受付番号",
        "APP.受付番号",
        "APP.申込日",
        "APP.申込者氏名",
        "PAY.生年月日",
        "PAY.決済ステータス",
        "PAIRED.決済確認済",
        "$work",
        "PAY.利用者ID",
        "PAY.利用者氏名",
        "PAY.利用者区分"
      ]
    },
    "actions": {
      "updateRecords": "update-ledger",
      "deleteRecords": "delete-processed-records"
    },
    "candidates": {
      "applicationNumber": {
        "value": {
          "field": "PAY.受付番号照合用",
          "empty": ""
        }
      },
      "cardNumber": {
        "value": {
          "field": "PAY.識別番号照合用",
          "empty": ""
        }
      },
      "applicant": {
        "value": {
          "field": "APP.申込者氏名",
          "empty": ""
        }
      },
      "applicationDate": {
        "value": {
          "field": "APP.申込日",
          "empty": "",
          "format": {
            "kind": "date",
            "from": "yyyyMMdd",
            "to": "yyyy/MM/dd"
          }
        }
      },
      "payment": {
        "value": {
          "field": "PAIRED.決済確認済",
          "empty": "未決済"
        },
        "looks": {
          "支払済": "accent",
          "*": "neutral"
        }
      }
    }
  }
}
