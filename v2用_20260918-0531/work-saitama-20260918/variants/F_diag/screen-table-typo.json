{
  "schema": 3,
  "業務設定": {
    "入力ファイル": {
      "取引": { "ファイル名": "01_取引データ.csv", "一致": "前方一致", "識別する列": "【共通】取引ID" },
      "決済": { "ファイル名": "02_決済データ.csv", "一致": "前方一致", "識別する列": "オーダーID" },
      "受付": { "ファイル名": "03_受付データ.csv", "一致": "前方一致", "識別する列": "受付時＿識別番号" },
      "削除用": { "ファイル名": "04_削除用_手続完了.csv", "一致": "前方一致", "識別する列": ["識別番号", "受付番号"] }
    },
    "切り出し": {
      "取引.識別番号": "regexExtract(取引.【共通】取引ID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
      "決済.識別番号": "regexExtract(決済.オーダーID, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
      "決済.受付番号（照合用）": "regexExtract(決済.備考2, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')",
      "決済.利用者ID": "splitPart(決済.氏名, '-', 0)",
      "決済.利用者氏名": "splitPart(決済.氏名, '-', 1)",
      "決済.利用者区分": "splitPart(決済.備考2, '/', 5)",
      "決済.生年月日": "splitPart(決済.備考2, '/', 1)",
      "決済.受付拠点": "splitPart(決済.備考2, '/', 4)",
      "受付.識別番号": "regexExtract(受付.受付時＿識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
      "受付.受付番号（照合用）": "regexExtract(受付.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')",
      "削除用.識別番号（照合用）": "regexExtract(削除用.識別番号, '[A-Z]{2}[0-9]{8}[A-Z]{2}')",
      "削除用.受付番号（照合用）": "regexExtract(削除用.受付番号, '(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10}')"
    },
    "つなぎ方": [
      { "左": "決済.識別番号", "右": "取引.識別番号", "残す行": "両方にある行" },
      { "左": "決済.識別番号", "右": "受付.識別番号", "残す行": "左は全部" }
    ],
    "支払済の条件": [
      { "列": "取引.【共通】ステータス", "値": "支払済" },
      { "列": "決済.決済ステータス", "値": "決済済" }
    ],
    "台帳の1件を決める列": ["決済.識別番号", "決済.受付番号（照合用）"],
    "検索に使う列": ["決済.識別番号", "決済.受付番号（照合用）", "受付.受付番号（照合用）"],
    "台帳に追加で残す列": ["取引.【共通】取引ID", "決済.オーダーID", "決済.決済金額", "取引.【共通】ステータス", "取引.【共通】取引結果"],
    "削除の条件": {
      "ファイル": "削除用",
      "一致させる列": [
        { "台帳の列": "決済.識別番号", "削除用の列": "削除用.識別番号（照合用）" },
        { "台帳の列": ["受付.受付番号（照合用）", "決済.受付番号（照合用）"], "削除用の列": "削除用.受付番号（照合用）" }
      ]
    },
    "画面": {
      "検索欄のラベル": "識別番号／受付番号",
      "利用者情報": {
        "枠の名前": "利用者情報",
        "行": [
          { "ラベル": "利用者ID", "列": "決済.利用者ID" },
          { "ラベル": "利用者氏名", "列": "決済.利用者氏名" },
          { "ラベル": "利用者区分", "列": "決済.利用者区分" }
        ]
      },
      "受付情報": {
        "枠の名前": "受付情報",
        "行": [
          { "ラベル": "申込日", "列": "受付け.申込日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" },
          { "ラベル": "受付番号", "列": "決済.受付番号（照合用）" },
          { "ラベル": "識別番号", "列": "決済.識別番号" },
          { "ラベル": "申込者氏名", "列": "受付.申込者氏名" },
          { "ラベル": "生年月日", "列": "決済.生年月日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" },
          { "ラベル": "契約区分（期間）", "列": "受付.変更後の契約区分期間" },
          { "ラベル": "受付拠点", "列": "決済.受付拠点" }
        ]
      },
      "意見欄": { "枠の名前": "意見欄", "列": "受付.意見欄" },
      "変更後の計画": { "枠の名前": "変更後の計画", "列": "受付.変更後の計画" },
      "決済状況": { "枠の名前": "決済状況", "支払済の表示": "支払済", "未決済の表示": "未決済" },
      "候補一覧": [
        { "見出し": "受付番号", "列": "決済.受付番号（照合用）" },
        { "見出し": "識別番号", "列": "決済.識別番号" },
        { "見出し": "申込者氏名", "列": "受付.申込者氏名" },
        { "見出し": "申込日", "列": "受付け.申込日", "CSVの日付": "yyyyMMdd", "画面の日付": "yyyy/MM/dd" }
      ],
      "帳票出力の初期項目": [
        "受付.受付時＿識別番号", "決済.受付番号", "受付.受付番号", "受付.申込日", "受付.申込者氏名",
        "決済.生年月日", "決済.決済ステータス", "確認状態", "決済.利用者ID", "決済.利用者氏名", "決済.利用者区分"
      ]
    }
  },
  "paths": {
    "dataDir": "data",
    "ledger": "data/統合台帳.xlsx",
    "log": "data/操作ログ.log"
  },
  "search": {
    "pattern": "^(?:[A-Z]{2}[0-9]{8}[A-Z]{2}|(?:[\\p{IsCJKUnifiedIdeographs}\\p{IsKatakana}\\p{IsHiragana}]{1,5})?[A-Z]{1,4}[0-9]{1,4}-[0-9]{1,10})$",
    "candidateRowsShown": 100
  },
  "watch": {
    "pollMs": 40,
    "stableMs": 120,
    "rebindMs": 400,
    "preferFocusedWindow": true,
    "targets": [
      {
        "enabled": true,
        "name": "メモ帳",
        "window": {
          "className": "Notepad",
          "processName": "Notepad",
          "scope": "children"
        },
        "path": [],
        "field": {
          "className": "RichEditD2DPT",
          "controlTypes": [
            "Document"
          ],
          "requireValuePattern": true,
          "scope": "descendants"
        },
        "read": "value"
      }
    ]
  }
}
